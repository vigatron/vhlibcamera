#ifndef VHLIB_CAMERA_VERSION_H
#define VHLIB_CAMERA_VERSION_H

#define VHLIB_CAMERA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define VHLIB_CAMERA_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define VHLIB_CAMERA_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define VHLIB_CAMERA_VERSION_HEX ( \
    (VHLIB_CAMERA_VERSION_MAJOR * 10000) + \
    (VHLIB_CAMERA_VERSION_MINOR * 100) + \
    (VHLIB_CAMERA_VERSION_PATCH * 1) )

#endif
